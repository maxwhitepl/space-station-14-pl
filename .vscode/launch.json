{
    // Use IntelliSense to learn about possible attributes.
    // Hover to view descriptions of existing attributes.
    // For more information, visit: https://go.microsoft.com/fwlink/?linkid=830387
    "version": "0.2.0",
    "configurations": [
        {
            "name": "Client",
            "type": "coreclr",
            "request": "launch",
            "program": "${workspaceFolder}/bin/Content.Client/Content.Client.dll",
            "args": [],
            "console": "internalConsole",
            "runtimeArgs": [
                "-gcServer",           // Włącza serwerowy garbage collector dla lepszej wydajności
                "-gcHeapHardLimit",    // Twardy limit heapu w bajtach, np. 4GB
                "4294967296"           // 4GB = 4 * 1024^3
            ],
            "env": {
                "DOTNET_GCHeapHardLimit": "4294967296",  // Alternatywnie przez env (nowsze .NET)
                "DOTNET_GCHardLimit": "4294967296"       // Starsze wersje
            },
            "stopAtEntry": false
        },
        {
            "name": "Client (Compatibility renderer)",
            "type": "coreclr",
            "request": "launch",
            "program": "${workspaceFolder}/bin/Content.Client/Content.Client.dll",
            "args": "--cvar display.compat=true",
            "console": "internalConsole",
            "runtimeArgs": [
                "-gcServer",           // Włącza serwerowy garbage collector dla lepszą wydajność
                "-gcHeapHardLimit",    // Twardy limit heapu w bajtach, np. 4GB
                "4294967296"           // 4GB = 4 * 1024^3
            ],
            "env": {
                "DOTNET_GCHeapHardLimit": "4294967296",  // Alternatywnie przez env (nowsze .NET)
                "DOTNET_GCHardLimit": "4294967296"       // Starsze wersje
            },
            "stopAtEntry": false
        },
        {
            "name": "Server",
            "type": "coreclr",
            "request": "launch",
            "program": "${workspaceFolder}/bin/Content.Server/Content.Server.dll",
            "args": [],
            "console": "integratedTerminal",
            "runtimeArgs": [
                "-gcServer",           // Włącza serwerowy garbage collector dla lepszą wydajność
                "-gcHeapHardLimit",    // Twardy limit heapu w bajtach, np. 4GB
                "4294967296"           // 4GB = 4 * 1024^3
            ],
            "env": {
                "DOTNET_GCHeapHardLimit": "4294967296",  // Alternatywnie przez env (nowsze .NET)
                "DOTNET_GCHardLimit": "4294967296"       // Starsze wersje
            },
            "stopAtEntry": false
        },
        {
            "name": "YAML Linter",
            "type": "coreclr",
            "request": "launch",
            "preLaunchTask": "build-yaml-linter",
            "program": "${workspaceFolder}/bin/Content.YAMLLinter/Content.YAMLLinter.dll",
            "cwd": "${workspaceFolder}/Content.YAMLLinter",
            "console": "internalConsole",
            "runtimeArgs": [
                "-gcServer",           // Włącza serwerowy garbage collector dla lepszą wydajność
                "-gcHeapHardLimit",    // Twardy limit heapu w bajtach, np. 4GB
                "4294967296"           // 4GB = 4 * 1024^3
            ],
            "env": {
                "DOTNET_GCHeapHardLimit": "4294967296",  // Alternatywnie przez env (nowsze .NET)
                "DOTNET_GCHardLimit": "4294967296"       // Starsze wersje
            },
            "stopAtEntry": false
        }
    ],
    "compounds": [
        {
            "name": "Server/Client",
            "configurations": [
                "Server",
                "Client"
            ],
            "preLaunchTask": "build"
        }
    ]
}